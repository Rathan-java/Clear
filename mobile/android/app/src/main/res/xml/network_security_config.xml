<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE config: HTTPS only, with a short allow-list for local development.

  Android matches these entries exactly - there is no CIDR/subnet syntax - so
  if you want a *release* APK to talk to a backend on your LAN over plain HTTP,
  add that exact address below:

      <domain includeSubdomains="false">192.168.1.28</domain>

  Debug builds do not need this: src/debug/res/xml/network_security_config.xml
  allows cleartext everywhere.

  Once your backend is on HTTPS, delete the whole domain-config block.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's view of the host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Add your own LAN address here for release-over-HTTP testing -->
    </domain-config>
</network-security-config>

# ---------------------------------------------------------------------------
# Clear backend configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# HTTP
PORT=8080
NODE_ENV=development

# Comma separated list of allowed origins. "*" allows any (dev only).
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Firebase (free Spark plan is enough)
# Option A - paste the whole service-account JSON, base64 encoded:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('service-account.json')).toString('base64'))"
# Option B - point at a file on disk with GOOGLE_APPLICATION_CREDENTIALS
# If neither is set the server falls back to an in-memory store (dev only).
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Auto-create an account on first /login (handy for solo use, disable for teams)
ALLOW_AUTO_REGISTER=true
# Pairing code lifetime in seconds
PAIRING_CODE_TTL=300
# Heartbeat: server pings every N ms, drops a socket after M missed pongs
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=45000
# How many transcript lines / answers to keep per meeting in history responses
HISTORY_PAGE_SIZE=50

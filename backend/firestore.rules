rules_version = '2';

// The backend talks to Firestore with the Admin SDK, which bypasses these rules.
// They exist to lock the database down if a client SDK key ever leaks: nothing
// is readable or writable directly from a browser/phone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Optional bootstrap values for the desktop app.
# Everything here can also be set in the in-app Settings panel, which is the
# recommended path - the Gemini key is then encrypted at rest with Windows DPAPI.

# Backend base URL (no trailing slash)
CLEAR_BACKEND_URL=http://localhost:8080

# Gemini API key - https://aistudio.google.com/apikey
# Only ever lives on this machine; it is never sent to the backend.
GEMINI_API_KEY=

# Model overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# Dev only: point the main process at the Vite dev server
# CLEAR_DEV_SERVER=http://localhost:5173

# Optional bootstrap values for the desktop app.
# Everything here can also be set in the app itself, which is the recommended
# path - the Gemini key is then encrypted at rest with Windows DPAPI.

# ---------------------------------------------------------------------------
# Firebase - from Project settings > General > Your apps > Web app.
# Neither value is a secret; they identify the project, they grant nothing.
# Access is controlled by Authentication plus firebase/firestore.rules.
# ---------------------------------------------------------------------------
CLEAR_FIREBASE_API_KEY=
CLEAR_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Gemini API key - https://aistudio.google.com/apikey
# Only ever lives on this machine. It is never written to Firestore and the
# phone never sees it.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Model overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# Dev only
# CLEAR_DEV_SERVER=http://localhost:5173
# CLEAR_DEVTOOLS=1
# CLEAR_LOG_LEVEL=debug
